{
  "_about": [
    "Every image the game shows is named here. Code asks for names such as 'outlaw/aim'; this file maps them to files under res://assets/.",
    "Change the look by pointing a name at a new file (or replacing the file). No code changes are needed.",
    "Name format: '<set>/<animation>'. Each set becomes one SpriteFrames; each animation can have any number of frames.",
    "Entry: a file path, or {frames: [...]} or {sequence: {pattern, count}}, plus optional fps (default 8), loop (default true), anchor, points, theme.",
    "anchor: the image pixel that sits on the object's position. 'feet' and 'base' = bottom centre (the default), 'center', 'top_left', or [x, y] in pixels of the first frame.",
    "Art density: 1 image pixel = 1 pixel of the 1280x720 base resolution (4 pixels per gameplay unit); textures are filtered smoothly (linear). Sprite size never affects hitboxes; those live in data/geometry.json.",
    "points: named offsets in pixels from the anchor (e.g. a gun's muzzle).",
    "durations: optional relative length of each frame (e.g. a quick hammer strike after a long pause).",
    "theme: StyleBoxTexture slots in ui/theme.tres ('Type/stylebox') that use this image.",
    "nine_patch: the border, in pixels, kept unstretched when the image is stretched to fit (e.g. the clue glow).",
    "Duel bosses use '<boss>_duel' sets, drawn closer and twice the street size; street versions use '<boss>'."
  ],

  "scenes": {
    "main_street": {
      "layers": ["main_street/sky", "main_street/far", "main_street/buildings", "main_street/street"],
      "window_frames": ["main_street/window_0", "main_street/window_1", "main_street/window_2", "main_street/window_3"]
    },
    "splash": {"layers": ["splash/sky", "splash/far", "splash/street"]},
    "office": {"layers": ["office/room"]}
  },


  "rigs_about": [
    "Cut-out characters: each outlaw is built from separate parts, placed at joints and animated by the shared clips below.",
    "Part: name, asset (a manifest name), at (joint position in pixels, relative to the parent part or to the feet), optional parent, behind (drawn behind its parent) and hidden (off until a clip shows it).",
    "Clip tracks are 'part:property' (or 'rig:flash' for the white hit flash) with [time, value] keys: rotation in degrees, position as a pixel offset from the joint, scale, visible, frame.",
    "Gameplay picks the clip: pop_up as he rises, aim while his draw ring runs, flinch when hit, fall when he goes down, run between cover, idle otherwise."
  ],
  "rigs": {
    "outlaw": {
      "animations": "outlaw",
      "parts": [
        {"name": "legs", "asset": "outlaw_parts/legs", "at": [0, -20]},
        {"name": "torso", "asset": "outlaw_parts/torso", "at": [0, -20]},
        {"name": "arm_back", "asset": "outlaw_parts/arm_back", "parent": "torso", "at": [-18, -20], "behind": true},
        {"name": "head", "asset": "outlaw_parts/head", "parent": "torso", "at": [0, -24]},
        {"name": "arm_front", "asset": "outlaw_parts/arm_front", "parent": "torso", "at": [18, -20]},
        {"name": "gun_hand", "asset": "outlaw_parts/gun_hand", "parent": "torso", "at": [0, -10], "hidden": true}
      ]
    }
,
    "iron_eli": {
      "animations": "outlaw",
      "parts": [
        {"name": "legs", "asset": "iron_eli_parts/legs", "at": [0, -20]},
        {"name": "torso", "asset": "iron_eli_parts/torso", "at": [0, -20]},
        {"name": "arm_back", "asset": "iron_eli_parts/arm_back", "parent": "torso", "at": [-18, -20], "behind": true},
        {"name": "armour", "asset": "iron_eli_parts/armour", "parent": "torso", "at": [0, 0], "hidden": true},
        {"name": "head", "asset": "iron_eli_parts/head", "parent": "torso", "at": [0, -24]},
        {"name": "arm_front", "asset": "iron_eli_parts/arm_front", "parent": "torso", "at": [18, -20]},
        {"name": "gun_hand", "asset": "iron_eli_parts/gun_hand", "parent": "torso", "at": [0, -10], "hidden": true}
      ]
    }
,
    "black_jack": {
      "animations": "outlaw",
      "parts": [
        {"name": "legs", "asset": "black_jack_parts/legs", "at": [0, -20]},
        {"name": "torso", "asset": "black_jack_parts/torso", "at": [0, -20]},
        {"name": "arm_back", "asset": "black_jack_parts/arm_back", "parent": "torso", "at": [-18, -20], "behind": true},
        {"name": "head", "asset": "black_jack_parts/head", "parent": "torso", "at": [0, -24]},
        {"name": "arm_front", "asset": "black_jack_parts/arm_front", "parent": "torso", "at": [18, -20]},
        {"name": "gun_hand", "asset": "black_jack_parts/gun_hand", "parent": "torso", "at": [0, -10], "hidden": true}
      ]
    }
  },
  "rig_animations": {
    "outlaw": {
      "idle": {"length": 1.2, "loop": true, "tracks": {
        "torso:scale": [[0, [1, 1]], [0.6, [1, 1.03]], [1.2, [1, 1]]],
        "head:rotation": [[0, 0], [0.6, -2], [1.2, 0]]}},
      "pop_up": {"length": 0.25, "tracks": {
        "torso:scale": [[0, [1.06, 0.86]], [0.12, [0.97, 1.06]], [0.25, [1, 1]]],
        "head:rotation": [[0, -10], [0.25, 0]]}},
      "aim": {"length": 0.3, "tracks": {
        "arm_back:visible": [[0, false]], "arm_front:visible": [[0, false]], "gun_hand:visible": [[0, true]],
        "gun_hand:scale": [[0, [0.7, 0.7]], [0.12, [1.1, 1.1]], [0.3, [1, 1]]],
        "torso:rotation": [[0, 0], [0.3, -3]],
        "head:rotation": [[0, 0], [0.3, 4]]}},
      "flinch": {"length": 0.25, "tracks": {
        "rig:flash": [[0, 1], [0.08, 1], [0.25, 0]],
        "torso:rotation": [[0, 0], [0.08, -12], [0.25, -6]],
        "head:rotation": [[0, 0], [0.08, -22], [0.25, -12]],
        "arm_back:rotation": [[0, 0], [0.1, -40]],
        "arm_front:rotation": [[0, 0], [0.1, 40]]}},
      "fall": {"length": 1.0, "tracks": {
        "rig:flash": [[0, 1], [0.08, 1], [0.2, 0]],
        "head:rotation": [[0, -12], [0.4, -30]],
        "arm_back:rotation": [[0, -40], [0.5, -110]],
        "arm_front:rotation": [[0, 40], [0.5, 110]],
        "legs:rotation": [[0, 0], [0.5, 10]]}},
      "run": {"length": 0.27, "loop": true, "tracks": {
        "legs:frame": [[0, 1], [0.135, 0]],
        "torso:position": [[0, [0, 0]], [0.135, [0, -2]], [0.27, [0, 0]]],
        "arm_back:rotation": [[0, 25], [0.135, -25], [0.27, 25]],
        "arm_front:rotation": [[0, -25], [0.135, 25], [0.27, -25]]}}
    }
  },

