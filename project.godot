; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="High Noon"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.164706, 0.101961, 0.0627451, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://autoload/save_manager.gd"
GameState="*res://autoload/game_state.gd"
Assets="*res://autoload/assets.gd"
AudioManager="*res://autoload/audio_manager.gd"
AdsManager="*res://autoload/ads_manager.gd"
Haptics="*res://autoload/haptics.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.0784314, 0.0470588, 0.0313726, 1)

[gui]

theme/custom="res://ui/theme.tres"
